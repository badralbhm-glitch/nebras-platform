# Nebras Platform - Environment Variables Template (No real secrets!)
APP_ENV=local
APP_DEBUG=true

# Database (MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nebras_db
DB_USERNAME=root
DB_PASSWORD=

# Multi-Tenant & Widget
DEFAULT_TENANT_ID=
WIDGET_ALLOWED_ORIGINS=

# Automation (n8n & Telegram)
N8N_WEBHOOK_URL=
INTERNAL_SERVICE_TOKEN=
TELEGRAM_BOT_TOKEN=

# Optional Search & AI
MEILISEARCH_HOST=
MEILISEARCH_KEY=
AI_API_KEY=
